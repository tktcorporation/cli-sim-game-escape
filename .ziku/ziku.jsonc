    ".devcontainer/.gitignore",
    ".devcontainer/setup-*.sh",
    ".devcontainer/test-*.sh",
    ".devcontainer/.env.devcontainer.example",
    ".devcontainer/run-chrome-devtools-mcp.sh",
    ".github/workflows/issue-link.yml",
    ".github/workflows/label.yml",
    ".github/labeler.yml",
    ".mcp.json",
    ".mise.toml",
    ".claude/.gitignore",
    ".claude/guides/tools/ziku.md",
    ".claude/skills/package-upgrade/SKILL.md",
    ".claude/skills/data-driven-prd",
    ".claude/skills/evergreen-writing",
    ".claude/skills/pr-deep-review",
    ".claude/skills/pr-first-reader-check",
    ".claude/skills/pr-impact-review",
    ".claude/skills/pr-review-loop",
    ".claude/skills/prd-review",
    ".claude/skills/technical-writing-style",
    ".claude/skills/upstream-fix",
    ".config/mise/conf.d/shared.toml",
    ".config/docs-lifecycle.json",
    "scripts/docs-lifecycle.ts",
    "scripts/lib/docs-lifecycle",
    ".claude/hooks/record-pr-review.sh",
    ".claude/hooks/require-pr-self-review.sh",
    ".claude/rules/ci-workflow.md",
    ".claude/rules/code-intent-documentation.md",
    ".claude/rules/codex-pairing.md",
    ".claude/rules/parallel-work.md",
    ".claude/rules/pr-self-review.md",
